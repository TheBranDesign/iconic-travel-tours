---
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
  showTagline?: boolean;
}

const { variant = 'light', class: className = '', showTagline = false } = Astro.props;

// light variant is for dark backgrounds (white text + gold/red)
// dark variant is for light backgrounds (emerald text + gold/red)
const isDarkBackground = variant === 'light';
---

<a href="/iconic-travel-tours/" class={`inline-flex items-center gap-3 group transition-transform duration-300 ${className}`} aria-label="Iconic Travel & Tours - Return to Homepage">
  <!-- Brand Icon -->
  <div class="relative w-10 h-10 flex-shrink-0 flex items-center justify-center rounded-full bg-gradient-to-br from-brand-emerald to-brand-forest border border-brand-gold/40 shadow-sm group-hover:border-brand-gold transition-colors">
    <svg viewBox="0 0 40 40" class="w-7 h-7" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Pin / Arch shape -->
      <path d="M20 4C12.82 4 7 9.82 7 17C7 26.5 20 36 20 36C20 36 33 26.5 33 17C33 9.82 27.18 4 20 4Z" fill="#D92732" opacity="0.95"/>
      <!-- Inner golden ring -->
      <circle cx="20" cy="17" r="9" fill="#063D30" stroke="#C7A66A" stroke-width="1.2"/>
      <!-- Golden Crescent -->
      <path d="M21.5 12C18.5 12 16 14.2 16 17C16 19.8 18.5 22 21.5 22C19.5 21.2 18 19.3 18 17C18 14.7 19.5 12.8 21.5 12Z" fill="#C7A66A"/>
      <!-- Flight Plane Motif -->
      <path d="M19 14.5L24 17L19 19.5V17.8L21 17L19 16.2V14.5Z" fill="#FFFFFF"/>
    </svg>
  </div>

  <!-- Brand Typography -->
  <div class="flex flex-col text-left">
    <div class="flex items-baseline gap-1.5 leading-none">
      <span class={`font-serif text-2xl font-bold tracking-tight lowercase ${isDarkBackground ? 'text-white' : 'text-brand-emerald'}`}>
        iconic
      </span>
      <span class="text-[10px] font-sans font-semibold tracking-wider uppercase px-1.5 py-0.5 rounded bg-brand-gold/20 text-brand-gold border border-brand-gold/30">
        GL #5247
      </span>
    </div>
    <span class={`text-[11px] font-sans tracking-[0.22em] uppercase font-medium mt-1 ${isDarkBackground ? 'text-brand-gold-light' : 'text-brand-charcoal-muted'}`}>
      Travel & Tours
    </span>
    {showTagline && (
      <span class="text-[9px] font-sans tracking-widest uppercase text-brand-gold mt-0.5">
        Your Comfort, Our Priority
      </span>
    )}
  </div>
</a>
