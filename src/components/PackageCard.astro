---
interface Props {
  pkg: {
    slug: string;
    name: string;
    category: string;
    tag?: string;
    departureMonth: string;
    durationDays: number;
    makkahNights: number;
    madinahNights: number;
    heroImage: string;
    cardImage?: string;
    makkahHotel: string;
    madinahHotel: string;
    transport: string;
    pricePlaceholder: string;
    priceNote?: string;
    availability: string;
    overview: string;
  };
}

const { pkg } = Astro.props;
const displayImage = pkg.cardImage || pkg.heroImage;
---

<article class="bg-white rounded-2xl overflow-hidden border border-brand-gold/20 shadow-luxury hover:shadow-luxury-lg transition-all duration-300 flex flex-col group transform hover:-translate-y-1">
  <!-- Image Banner -->
  <div class="relative h-64 overflow-hidden bg-brand-forest">
    <img
      src={displayImage}
      alt={pkg.name}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

    <!-- Category & Tag Badges -->
    <div class="absolute top-4 left-4 flex flex-wrap gap-2">
      <span class="px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-brand-emerald text-brand-gold border border-brand-gold/30 shadow-sm backdrop-blur-sm">
        {pkg.category}
      </span>
      {pkg.tag && (
        <span class="px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-brand-red text-white shadow-sm">
          {pkg.tag}
        </span>
      )}
    </div>

    <!-- Duration Pill -->
    <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-white text-xs font-medium">
      <span class="flex items-center gap-1.5 bg-black/60 backdrop-blur-md px-3 py-1 rounded-lg border border-white/20">
        <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {pkg.durationDays} Days Total
      </span>
      <span class="bg-brand-gold/90 text-brand-emerald px-2.5 py-1 rounded-lg font-bold text-[11px]">
        {pkg.availability}
      </span>
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
    <div>
      <h3 class="font-serif text-2xl font-bold text-brand-emerald group-hover:text-brand-gold-dark transition-colors">
        <a href={`/iconic-travel-tours/umrah-packages/${pkg.slug}/`}>{pkg.name}</a>
      </h3>
      <p class="text-xs font-mono text-brand-gold-dark uppercase tracking-wider mt-1">
        Departure: {pkg.departureMonth}
      </p>

      <p class="text-xs text-brand-charcoal-muted line-clamp-2 mt-3 leading-relaxed">
        {pkg.overview}
      </p>
    </div>

    <!-- Key Package Specifications -->
    <div class="border-t border-b border-brand-ivory-dark py-3.5 space-y-2 text-xs text-brand-charcoal">
      <div class="flex items-start gap-2">
        <span class="font-semibold text-brand-emerald w-20 flex-shrink-0">Makkah:</span>
        <span class="text-brand-charcoal-muted truncate">{pkg.makkahNights} Nights • {pkg.makkahHotel}</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="font-semibold text-brand-emerald w-20 flex-shrink-0">Madinah:</span>
        <span class="text-brand-charcoal-muted truncate">{pkg.madinahNights} Nights • {pkg.madinahHotel}</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="font-semibold text-brand-emerald w-20 flex-shrink-0">Transport:</span>
        <span class="text-brand-charcoal-muted truncate">{pkg.transport}</span>
      </div>
    </div>

    <!-- Pricing Demonstration Indicator -->
    <div class="bg-brand-ivory rounded-xl p-3 border border-brand-gold/15 flex items-center justify-between">
      <div>
        <span class="block text-[10px] uppercase font-mono tracking-wider text-brand-charcoal-muted">Estimated Rate</span>
        <span class="font-serif text-base font-bold text-brand-emerald">{pkg.pricePlaceholder}</span>
      </div>
      <span class="text-[10px] text-brand-gold-dark bg-white px-2 py-0.5 rounded border border-brand-gold/30">
        GL #5247 Verified
      </span>
    </div>

    <!-- Action Buttons -->
    <div class="grid grid-cols-2 gap-2 pt-1">
      <a
        href={`/iconic-travel-tours/umrah-packages/${pkg.slug}/`}
        class="inline-flex items-center justify-center py-2.5 px-3 rounded-xl text-xs font-bold tracking-wider uppercase text-brand-emerald bg-brand-ivory hover:bg-brand-gold/20 border border-brand-gold/30 transition-all text-center"
      >
        View Package
      </a>
      <a
        href={`https://wa.me/923009222123?text=${encodeURIComponent(`Assalamu Alaikum Iconic Travel & Tours. I would like to inquire about the "${pkg.name}" (${pkg.durationDays} Days) package.`)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl text-xs font-bold tracking-wider uppercase bg-[#25D366] text-white hover:brightness-105 transition-all text-center shadow-sm"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
</article>
