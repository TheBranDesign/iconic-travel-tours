---
import Logo from './Logo.astro';
import company from '../data/company.json';

const navLinks = [
  { href: '/iconic-travel-tours/', label: 'Home' },
  { href: '/iconic-travel-tours/about/', label: 'About Us' },
  { href: '/iconic-travel-tours/umrah-packages/', label: 'Umrah Packages' },
  { href: '/iconic-travel-tours/services/', label: 'Services' },
  { href: '/iconic-travel-tours/destinations/', label: 'Destinations' },
  { href: '/iconic-travel-tours/ziyarat-guide/', label: 'Ziyarat Guide' },
  { href: '/iconic-travel-tours/travel-guide/', label: 'Travel Guide' },
  { href: '/iconic-travel-tours/gallery/', label: 'Gallery' },
  { href: '/iconic-travel-tours/contact/', label: 'Contact' }
];

const currentPath = Astro.url.pathname;
const cleanPath = currentPath.endsWith('/') && currentPath.length > 1 ? currentPath.slice(0, -1) : currentPath;
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-brand-emerald/90 backdrop-blur-md border-b border-brand-gold/15 py-3 lg:py-4">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
      
      <!-- Brand Logo -->
      <Logo variant="light" />

      <!-- Desktop Navigation Menu -->
      <nav class="hidden xl:flex items-center gap-6" aria-label="Main Navigation">
        {navLinks.map((link) => {
          const normalizedLink = link.href.endsWith('/') && link.href.length > 1 ? link.href.slice(0, -1) : link.href;
          const isActive = cleanPath === normalizedLink || (link.href !== '/iconic-travel-tours/' && cleanPath.startsWith(normalizedLink));
          return (
            <a
              href={link.href}
              class={`text-[13px] uppercase tracking-wider font-medium transition-all duration-200 relative py-1 ${
                isActive 
                  ? 'text-brand-gold font-semibold' 
                  : 'text-brand-ivory hover:text-brand-gold'
              }`}
            >
              {link.label}
              {isActive && (
                <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-brand-gold rounded-full" />
              )}
            </a>
          );
        })}
      </nav>

      <!-- Right Action CTAs -->
      <div class="flex items-center gap-3">
        <!-- Search Trigger Button -->
        <button
          type="button"
          id="search-trigger-btn"
          class="p-2 text-brand-ivory hover:text-brand-gold rounded-full hover:bg-white/5 transition-colors"
          aria-label="Open Search Dialog"
          title="Search packages and guides"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <!-- Direct WhatsApp CTA -->
        <a
          href={`https://wa.me/${company.primaryWhatsApp}?text=${encodeURIComponent('Assalamu Alaikum. I am interested in inquiring about Iconic Travel & Tours Umrah services.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-[#25D366]/15 text-[#25D366] border border-[#25D366]/40 hover:bg-[#25D366] hover:text-white transition-all shadow-sm"
          title="Direct WhatsApp Support"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span class="tracking-wide">WhatsApp</span>
        </a>

        <!-- Request a Quote CTA -->
        <a
          href="/iconic-travel-tours/request-a-quote/"
          class="hidden md:inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase bg-gradient-to-r from-brand-gold to-brand-gold-dark text-brand-emerald hover:brightness-110 shadow-md transition-all transform hover:-translate-y-0.5"
        >
          <span>Request Quote</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="xl:hidden p-2 text-brand-ivory hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded-lg transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
          aria-label="Toggle navigation menu"
        >
          <svg id="menu-icon-bars" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu-drawer"
    class="xl:hidden fixed inset-x-0 top-[65px] bottom-0 bg-brand-emerald/98 backdrop-blur-xl border-t border-brand-gold/20 p-6 flex flex-col justify-between overflow-y-auto transform translate-x-full transition-transform duration-300 ease-in-out"
    style="visibility: hidden;"
  >
    <div class="space-y-3">
      <div class="pb-3 border-b border-brand-gold/15 mb-4">
        <span class="text-xs uppercase tracking-widest text-brand-gold font-semibold">Menu Navigation</span>
      </div>
      {navLinks.map((link) => {
        const normalizedLink = link.href.endsWith('/') && link.href.length > 1 ? link.href.slice(0, -1) : link.href;
        const isActive = cleanPath === normalizedLink || (link.href !== '/iconic-travel-tours/' && cleanPath.startsWith(normalizedLink));
        return (
          <a
            href={link.href}
            class={`block text-lg py-2 font-serif tracking-wide border-b border-white/5 transition-colors ${
              isActive ? 'text-brand-gold font-bold pl-2 border-l-2 border-brand-gold' : 'text-brand-ivory hover:text-brand-gold'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </div>

    <!-- Mobile Drawer Footer Actions -->
    <div class="pt-6 border-t border-brand-gold/20 space-y-3">
      <a
        href="/iconic-travel-tours/request-a-quote/"
        class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-semibold tracking-wider uppercase bg-brand-gold text-brand-emerald shadow-lg"
      >
        <span>Request a Free Quote</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>

      <div class="grid grid-cols-2 gap-2 text-center text-xs">
        <a
          href={`https://wa.me/${company.primaryWhatsApp}?text=${encodeURIComponent('Assalamu Alaikum. I am contacting Iconic Travel & Tours regarding Umrah packages.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-1.5 py-2.5 rounded-lg bg-[#25D366]/20 text-[#25D366] border border-[#25D366]/40 font-medium"
        >
          <span>WhatsApp Us</span>
        </a>
        <a
          href={`tel:${company.contacts[0].number}`}
          class="flex items-center justify-center gap-1.5 py-2.5 rounded-lg bg-white/10 text-white border border-white/20 font-medium"
        >
          <span>Call Desk</span>
        </a>
      </div>

      <div class="text-center pt-2">
        <p class="text-[11px] text-brand-ivory/60">Iconic Travel & Tours • GL #5247</p>
        <p class="text-[10px] text-brand-gold/80 italic mt-0.5">Your Comfort, Our Priority</p>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile drawer toggle logic
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menuDrawer = document.getElementById('mobile-menu-drawer');
  const barsIcon = document.getElementById('menu-icon-bars');
  const closeIcon = document.getElementById('menu-icon-close');

  if (menuBtn && menuDrawer && barsIcon && closeIcon) {
    let isOpen = false;

    const toggleMenu = () => {
      isOpen = !isOpen;
      menuBtn.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        menuDrawer.style.visibility = 'visible';
        menuDrawer.classList.remove('translate-x-full');
        barsIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      } else {
        menuDrawer.classList.add('translate-x-full');
        barsIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        document.body.style.overflow = '';
        setTimeout(() => {
          if (!isOpen) menuDrawer.style.visibility = 'hidden';
        }, 300);
      }
    };

    menuBtn.addEventListener('click', toggleMenu);
  }

  // Scroll effect on header
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (!header) return;
    if (window.scrollY > 40) {
      header.classList.add('shadow-luxury', 'bg-brand-emerald');
      header.classList.remove('bg-brand-emerald/90');
    } else {
      header.classList.remove('shadow-luxury', 'bg-brand-emerald');
      header.classList.add('bg-brand-emerald/90');
    }
  }, { passive: true });
</script>
