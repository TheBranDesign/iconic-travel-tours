---
import Logo from './Logo.astro';
import company from '../data/company.json';

const currentYear = new Date().getFullYear();
---

<footer class="bg-gradient-to-b from-brand-forest to-[#041A14] text-brand-ivory border-t border-brand-gold/20 pt-16 pb-10 relative overflow-hidden">
  
  <!-- Subtle Islamic star / geometric decorative ambient glow -->
  <div class="absolute inset-0 opacity-5 pointer-events-none bg-[radial-gradient(#C7A66A_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Editorial Header & Tagline Banner -->
    <div class="pb-12 border-b border-brand-gold/15 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <Logo variant="light" showTagline={true} />
        <p class="font-arabic text-xl text-brand-gold-light mt-3 tracking-wide" dir="rtl">
          {company.arabicGreeting} • {company.bismillah}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <a
          href="/iconic-travel-tours/request-a-quote/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-bold tracking-widest uppercase bg-gradient-to-r from-brand-gold to-brand-gold-dark text-brand-emerald shadow-gold-glow hover:brightness-110 transition-all transform hover:-translate-y-0.5"
        >
          <span>Plan Your Journey</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>

        <a
          href={`https://wa.me/${company.primaryWhatsApp}?text=${encodeURIComponent('Assalamu Alaikum. I would like to speak to an Iconic Travel & Tours consultant.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full text-xs font-semibold tracking-wider bg-white/5 hover:bg-[#25D366]/20 text-[#25D366] border border-[#25D366]/40 transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>WhatsApp (+92 300 9222123)</span>
        </a>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 py-12">
      
      <!-- Column 1: Philosophy & Identity -->
      <div class="lg:col-span-2 space-y-4">
        <h4 class="font-serif text-lg font-semibold tracking-wider text-brand-gold uppercase">
          A Journey of Faith
        </h4>
        <p class="text-sm text-brand-ivory/80 leading-relaxed max-w-sm">
          Iconic Travel & Tours (GL #5247) is dedicated to elevating the pilgrimage experience through meticulous organization, luxury hospitality, and attentive 24/7 on-ground guidance. We honor your spiritual quest with transparency and sincere devotion.
        </p>

        <!-- Official Industry Accreditation Marks -->
        <div class="pt-3">
          <p class="text-xs uppercase tracking-widest text-brand-gold/80 font-semibold mb-2">Verified Affiliations</p>
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-black/30 border border-brand-gold/30 text-[11px] font-mono text-brand-gold">
              <svg class="w-3.5 h-3.5 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              DTS GL #5247
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-black/30 border border-brand-gold/20 text-[11px] font-mono text-brand-ivory/80">
              TAAP Member
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-black/30 border border-brand-gold/20 text-[11px] font-mono text-brand-ivory/80">
              IATA Ticketing Network
            </span>
          </div>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h4 class="font-serif text-base font-semibold tracking-wider text-brand-gold uppercase mb-4">
          Navigation
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/iconic-travel-tours/" class="hover:text-brand-gold transition-colors">Home</a></li>
          <li><a href="/iconic-travel-tours/about/" class="hover:text-brand-gold transition-colors">About Us</a></li>
          <li><a href="/iconic-travel-tours/umrah-packages/" class="hover:text-brand-gold transition-colors">Umrah Packages</a></li>
          <li><a href="/iconic-travel-tours/services/" class="hover:text-brand-gold transition-colors">Services</a></li>
          <li><a href="/iconic-travel-tours/destinations/" class="hover:text-brand-gold transition-colors">Destinations</a></li>
          <li><a href="/iconic-travel-tours/gallery/" class="hover:text-brand-gold transition-colors">Visual Gallery</a></li>
          <li><a href="/iconic-travel-tours/faq/" class="hover:text-brand-gold transition-colors">Frequently Asked</a></li>
        </ul>
      </div>

      <!-- Column 3: Sacred Resources -->
      <div>
        <h4 class="font-serif text-base font-semibold tracking-wider text-brand-gold uppercase mb-4">
          Pilgrim Guides
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/iconic-travel-tours/ziyarat-guide/" class="hover:text-brand-gold transition-colors">Makkah & Madinah Ziyarat</a></li>
          <li><a href="/iconic-travel-tours/travel-guide/" class="hover:text-brand-gold transition-colors">Umrah Preparation Guide</a></li>
          <li><a href="/iconic-travel-tours/travel-guide/#ihram-guidance" class="hover:text-brand-gold transition-colors">Ihram Guidelines</a></li>
          <li><a href="/iconic-travel-tours/travel-guide/#packing-essentials" class="hover:text-brand-gold transition-colors">Packing Essentials</a></li>
          <li><a href="/iconic-travel-tours/destinations/makkah/" class="hover:text-brand-gold transition-colors">Makkah al-Mukarramah</a></li>
          <li><a href="/iconic-travel-tours/destinations/madinah/" class="hover:text-brand-gold transition-colors">Al-Madinah al-Munawwarah</a></li>
          <li><a href="/iconic-travel-tours/request-a-quote/" class="hover:text-brand-gold transition-colors">Custom Quote Request</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact & Office -->
      <div>
        <h4 class="font-serif text-base font-semibold tracking-wider text-brand-gold uppercase mb-4">
          Head Office
        </h4>
        <div class="space-y-3 text-sm text-brand-ivory/80">
          <p class="leading-relaxed">
            <span class="block font-semibold text-white">Iconic Travel & Tours</span>
            Office #502, Iconic Business Center,<br />
            Sharfabad, Karachi, Pakistan.
          </p>

          <div class="pt-1 space-y-1.5 font-mono text-xs">
            <p>
              <a href="tel:+923322177752" class="hover:text-brand-gold transition-colors flex items-center gap-2">
                <span class="text-brand-gold">Tel:</span> +92-332-2177752
              </a>
            </p>
            <p>
              <a href="tel:+923219199999" class="hover:text-brand-gold transition-colors flex items-center gap-2">
                <span class="text-brand-gold">Tel:</span> +92-321-9199999
              </a>
            </p>
            <p>
              <a href="https://wa.me/923009222123" target="_blank" rel="noopener noreferrer" class="hover:text-brand-gold transition-colors flex items-center gap-2 text-[#25D366]">
                <span class="text-brand-gold">WhatsApp:</span> +92 300 9222123
              </a>
            </p>
          </div>

          <p class="text-xs text-brand-gold pt-1">
            <a href="mailto:inquiry@iconictravelandtours.com" class="underline hover:text-white transition-colors">
              inquiry@iconictravelandtours.com
            </a>
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-8 mt-8 border-t border-brand-gold/15 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-brand-ivory/60">
      <p>
        © {currentYear} Iconic Travel & Tours. All rights reserved. Registered Govt License GL #5247.
      </p>

      <div class="flex items-center gap-6">
        <a href="/iconic-travel-tours/privacy-policy/" class="hover:text-brand-gold transition-colors">Privacy Policy</a>
        <span>•</span>
        <a href="/iconic-travel-tours/terms-and-conditions/" class="hover:text-brand-gold transition-colors">Terms & Conditions</a>
        <span>•</span>
        <a href="/iconic-travel-tours/sitemap.xml" class="hover:text-brand-gold transition-colors">Sitemap</a>
      </div>
    </div>

    <!-- Demonstration Notice / Compliance Note -->
    <div class="mt-6 pt-4 border-t border-white/5 text-[11px] text-center text-brand-ivory/40">
      <p>
        Notice: Package prices, seasonal dates and hotel availability are subject to live verification. Custom quotes are furnished upon inquiry through our verified Karachi reservation desk.
      </p>
    </div>

  </div>
</footer>
