---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SearchModal from '../components/SearchModal.astro';
import company from '../data/company.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = "Iconic Travel & Tours (GL #5247) | Premium Umrah & International Travel",
  description = "Iconic Travel & Tours — Licensed Umrah specialists (GL #5247) based in Karachi. Dedicated group assistance, luxury hotel accommodation in Makkah & Madinah, and personalized spiritual journeys.",
  image = "/iconic-travel-tours/images/hero-kaaba-tawaf.jpg",
  type = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://thebrandesign.github.io');
const ogImageURL = new URL(image, Astro.site || 'https://thebrandesign.github.io');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": "Iconic Travel & Tours",
  "legalName": "Iconic Travel & Tours (Pvt) Ltd",
  "identifier": "GL #5247",
  "slogan": "Your Comfort, Our Priority",
  "description": description,
  "url": "https://thebrandesign.github.io/iconic-travel-tours/",
  "logo": "https://thebrandesign.github.io/iconic-travel-tours/images/hero-kaaba-tawaf.jpg",
  "image": ogImageURL.toString(),
  "telephone": "+92-332-2177752",
  "email": "inquiry@iconictravelandtours.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Office #502, Iconic Business Center, Sharfabad",
    "addressLocality": "Karachi",
    "addressRegion": "Sindh",
    "addressCountry": "PK"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "24.8829",
    "longitude": "67.0694"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "10:00",
    "closes": "19:00"
  },
  "priceRange": "$$"
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/iconic-travel-tours/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#063D30" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Iconic Travel & Tours" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Google Fonts Preconnect & Load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="bg-brand-ivory text-brand-charcoal font-sans antialiased selection:bg-brand-gold selection:text-brand-emerald min-h-screen flex flex-col">
    
    <!-- Global Header -->
    <Navbar />

    <!-- Search Modal Component -->
    <SearchModal />

    <!-- Main Content Container -->
    <main class="flex-grow pt-[65px] lg:pt-[72px]">
      <slot />
    </main>

    <!-- Floating WhatsApp Action -->
    <WhatsAppButton />

    <!-- Global Footer -->
    <Footer />
  </body>
</html>
