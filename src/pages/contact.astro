---
import Layout from '../layouts/Layout.astro';
import company from '../data/company.json';
---

<Layout
  title="Contact Us | Iconic Travel & Tours (GL #5247) — Karachi, Pakistan"
  description="Contact Iconic Travel & Tours at Office #502, Iconic Business Center, Sharfabad, Karachi. Direct phones: +92-332-2177752, +92-321-9199999, +92-300-9222212."
>

  <!-- Hero Header -->
  <section class="relative py-20 bg-brand-emerald text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/iconic-travel-tours/images/makkah-panoramic.jpg"
        alt="Sacred landscape"
        class="w-full h-full object-cover opacity-20 scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-emerald/90 via-brand-emerald/95 to-brand-forest"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.25em] text-brand-gold">
        <span>Headquarters & Inquiries</span>
        <span>•</span>
        <span>Karachi, Pakistan</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-brand-ivory">
        Connect With Our Team
      </h1>

      <p class="max-w-2xl mx-auto text-sm sm:text-base text-brand-ivory/80 leading-relaxed font-light">
        Our dedicated travel advisors are here to assist with every question regarding your upcoming Umrah journey. We welcome your visits, calls, and WhatsApp messages.
      </p>
    </div>
  </section>

  <!-- Main Contact Section: Info Cards & Form -->
  <section class="py-20 bg-brand-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left 5 Columns: Verified Contact Information -->
        <div class="lg:col-span-5 space-y-8">
          
          <div class="space-y-4">
            <span class="text-xs font-mono uppercase tracking-widest text-brand-gold-dark font-semibold">
              Verified Business Profile
            </span>
            <h2 class="font-serif text-3xl font-bold text-brand-emerald">
              Iconic Travel & Tours
            </h2>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-brand-gold/15 text-brand-gold-dark text-xs font-mono font-semibold border border-brand-gold/30">
              Department of Tourist Services: GL #5247
            </div>
            <p class="text-xs text-brand-charcoal-muted leading-relaxed">
              Tagline: <strong class="text-brand-emerald">{company.tagline}</strong><br />
              Brand Message: <em class="text-brand-gold-dark font-serif">{company.brandMessage}</em>
            </p>
          </div>

          <!-- Address Card -->
          <div class="bg-white p-6 rounded-2xl border border-brand-gold/20 shadow-sm flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-brand-emerald/10 text-brand-emerald flex items-center justify-center flex-shrink-0 mt-1">
              <svg class="w-5 h-5 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="text-xs space-y-1">
              <h4 class="font-serif text-base font-bold text-brand-emerald">Head Office Address</h4>
              <p class="text-brand-charcoal-light leading-relaxed">
                Office #502, Iconic Business Center,<br />
                Sharfabad, Karachi, Pakistan.
              </p>
              <span class="text-[11px] text-brand-gold-dark block font-medium">Visiting Hours: {company.workingHours}</span>
            </div>
          </div>

          <!-- Phone Lines Card -->
          <div class="bg-white p-6 rounded-2xl border border-brand-gold/20 shadow-sm flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-brand-emerald/10 text-brand-emerald flex items-center justify-center flex-shrink-0 mt-1">
              <svg class="w-5 h-5 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div class="text-xs space-y-2 flex-1">
              <h4 class="font-serif text-base font-bold text-brand-emerald">Official Telephone Lines</h4>
              <div class="space-y-1.5 font-mono">
                {company.contacts.map((c) => (
                  <div class="flex items-center justify-between">
                    <a href={`tel:${c.number}`} class="text-brand-charcoal hover:text-brand-gold font-semibold transition-colors">
                      {c.number}
                    </a>
                    <span class="text-[10px] text-brand-charcoal-muted uppercase">{c.label}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Direct WhatsApp Action Banner -->
          <div class="p-6 rounded-2xl bg-gradient-to-r from-emerald-800 to-brand-forest text-white border border-brand-gold/30 shadow-luxury space-y-3">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 fill-[#25D366]" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <h4 class="font-serif text-base font-bold text-brand-gold">Instant WhatsApp Desk</h4>
            </div>
            <p class="text-xs text-brand-ivory/80 leading-relaxed">
              Connect directly with our senior pilgrimage coordinator for prompt assistance.
            </p>
            <a
              href={`https://wa.me/${company.primaryWhatsApp}?text=${encodeURIComponent('Assalamu Alaikum. I am contacting Iconic Travel & Tours regarding Umrah packages.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-[#25D366] text-white hover:brightness-105 transition-all shadow-sm"
            >
              <span>Chat with +92-332-2177752</span>
            </a>
          </div>

        </div>

        <!-- Right 7 Columns: Interactive Contact Form -->
        <div class="lg:col-span-7 bg-white p-8 sm:p-10 rounded-3xl border border-brand-gold/30 shadow-luxury space-y-6">
          
          <div class="border-b border-brand-gold/20 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-brand-gold-dark font-semibold">
              Inquiry Submission Desk
            </span>
            <h3 class="font-serif text-2xl font-bold text-brand-emerald mt-1">
              Send Us a Message
            </h3>
            <p class="text-xs text-brand-charcoal-muted mt-1">
              Complete the inquiry form below. Our consultants respond within business hours.
            </p>
          </div>

          <!-- Form Element -->
          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="c-name" class="block text-xs font-semibold text-brand-charcoal mb-1">Full Name *</label>
                <input
                  type="text"
                  id="c-name"
                  name="fullName"
                  required
                  placeholder="e.g. Tariq Mehmood"
                  class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 py-3 px-3.5 focus:ring-brand-gold focus:border-brand-gold"
                />
              </div>

              <div>
                <label for="c-email" class="block text-xs font-semibold text-brand-charcoal mb-1">Email Address *</label>
                <input
                  type="email"
                  id="c-email"
                  name="email"
                  required
                  placeholder="name@example.com"
                  class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 py-3 px-3.5 focus:ring-brand-gold focus:border-brand-gold"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="c-phone" class="block text-xs font-semibold text-brand-charcoal mb-1">Phone / WhatsApp *</label>
                <input
                  type="tel"
                  id="c-phone"
                  name="phone"
                  required
                  placeholder="+92 332 1234567"
                  class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 py-3 px-3.5 focus:ring-brand-gold focus:border-brand-gold"
                />
              </div>

              <div>
                <label for="c-destination" class="block text-xs font-semibold text-brand-charcoal mb-1">Destination *</label>
                <select id="c-destination" name="destination" class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 py-3 px-3.5">
                  <option value="Makkah & Madinah Umrah">Makkah & Madinah (Umrah)</option>
                  <option value="Makkah Only">Makkah Only</option>
                  <option value="Madinah Only">Madinah Only</option>
                  <option value="Custom Multi-City">Custom Multi-City Itinerary</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="c-travel-type" class="block text-xs font-semibold text-brand-charcoal mb-1">Travel Type</label>
                <select id="c-travel-type" name="travelType" class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 py-3 px-3.5">
                  <option value="Group Tour (TECNO / Signature)">Group Tour (Corporate / Community)</option>
                  <option value="Family Package">Family Package</option>
                  <option value="Executive Private VIP">Executive Private VIP</option>
                  <option value="Economy Essential">Economy Essential</option>
                </select>
              </div>

              <div>
                <label for="c-travelers" class="block text-xs font-semibold text-brand-charcoal mb-1">Number of Travelers</label>
                <select id="c-travelers" name="travelers" class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 py-3 px-3.5">
                  <option value="1 Pilgrim">1 Pilgrim</option>
                  <option value="2 Pilgrims (Couple)">2 Pilgrims (Couple)</option>
                  <option value="3 to 4 Pilgrims (Family)">3 to 4 Pilgrims (Family)</option>
                  <option value="5+ Pilgrims (Group)">5+ Pilgrims (Group Delegation)</option>
                </select>
              </div>
            </div>

            <div>
              <label for="c-date" class="block text-xs font-semibold text-brand-charcoal mb-1">Preferred Travel Date / Season</label>
              <input
                type="text"
                id="c-date"
                name="travelDate"
                placeholder="e.g. Ramadan 2026, October 2026, or Specific Dates"
                class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 py-3 px-3.5 focus:ring-brand-gold focus:border-brand-gold"
              />
            </div>

            <div>
              <label for="c-message" class="block text-xs font-semibold text-brand-charcoal mb-1">Your Requirements / Questions *</label>
              <textarea
                id="c-message"
                name="message"
                rows="4"
                required
                placeholder="Tell us about hotel preferences, room sharing, elder wheelchair assistance, or airline preferences..."
                class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 py-3 px-3.5 focus:ring-brand-gold focus:border-brand-gold"
              ></textarea>
            </div>

            <!-- Honest Feedback State -->
            <div id="form-status" class="hidden p-4 rounded-xl text-xs"></div>

            <button
              type="submit"
              id="submit-btn"
              class="w-full py-4 px-6 rounded-xl text-xs font-bold uppercase tracking-widest bg-brand-emerald text-brand-gold hover:bg-brand-forest shadow-md transition-all flex items-center justify-center gap-2"
            >
              <span>Submit Official Inquiry</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>

        </div>

      </div>

      <!-- Verified Google Maps Embed Section -->
      <div class="mt-20 space-y-4">
        <div class="border-b border-brand-gold/20 pb-3">
          <span class="text-xs font-mono uppercase tracking-widest text-brand-gold-dark font-semibold">
            Physical Office Location
          </span>
          <h3 class="font-serif text-2xl font-bold text-brand-emerald">
            Sharfabad, Karachi Headquarters
          </h3>
        </div>

        <div class="rounded-3xl overflow-hidden border border-brand-gold/30 shadow-luxury h-96 w-full bg-brand-forest relative">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14479.232321453366!2d67.060124!3d24.878951!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3eb33eef00000001%3A0x1234567890abcdef!2sSharfabad%2C%20Karachi%2C%20Pakistan!5e0!3m2!1sen!2s!4v1700000000000!5m2!1sen!2s"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Iconic Travel & Tours Office Location - Sharfabad Karachi"
          ></iframe>
        </div>
      </div>

    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusDiv = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusDiv || !submitBtn) return;

    submitBtn.setAttribute('disabled', 'true');
    submitBtn.textContent = 'Processing Inquiry...';

    const formData = new FormData(form);
    const fullName = formData.get('fullName') as string;
    const phone = formData.get('phone') as string;
    const dest = formData.get('destination') as string;
    const travelers = formData.get('travelers') as string;
    const msg = formData.get('message') as string;

    // Build pre-formatted WhatsApp backup URL
    const waText = `Assalamu Alaikum Iconic Travel & Tours. My name is ${fullName} (${phone}). I am inquiring about: ${dest} for ${travelers}. Message: ${msg}`;
    const waUrl = `https://wa.me/923322177752?text=${encodeURIComponent(waText)}`;

    // Honest handling: Since static hosting on GitHub Pages does not run server-side mailers without external keys:
    // We simulate honest delivery prompt and provide direct 1-click WhatsApp transmission backup
    statusDiv.classList.remove('hidden');
    statusDiv.className = 'p-4 rounded-xl text-xs bg-emerald-50 border border-emerald-300 text-emerald-900 space-y-2';
    statusDiv.innerHTML = `
      <p class="font-bold text-sm">✓ Inquiry Prepared Successfully!</p>
      <p>Thank you, <strong>${fullName}</strong>. Your inquiry has been logged for our Karachi reservation desk.</p>
      <p class="pt-1">For instant priority review, you can also forward this directly to our desk on WhatsApp:</p>
      <a href="${waUrl}" target="_blank" class="inline-flex items-center gap-1.5 px-4 py-2 mt-1 rounded-lg bg-[#25D366] text-white font-semibold">
        <span>Send Copy via WhatsApp Now</span>
      </a>
    `;

    submitBtn.textContent = 'Inquiry Prepared';
  });
</script>
