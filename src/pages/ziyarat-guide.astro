---
import Layout from '../layouts/Layout.astro';
import ziyarat from '../data/ziyarat.json';
import company from '../data/company.json';

const makkahSites = ziyarat.filter(z => z.city === 'Makkah');
const madinahSites = ziyarat.filter(z => z.city === 'Madinah');
---

<Layout
  title="Ziyarat Guide to Makkah & Madinah | Iconic Travel & Tours (GL #5247)"
  description="Comprehensive educational guide to the sacred Ziyarat of Makkah and Madinah: Jabal al-Noor, Cave of Thawr, Mina, Arafat, Masjid Quba, Mount Uhud, and Jannat al-Baqi."
>

  <!-- Hero Banner -->
  <section class="relative py-20 bg-brand-emerald text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/iconic-travel-tours/images/jabal-al-noor.jpg"
        alt="Jabal al-Noor Mountain of Light"
        class="w-full h-full object-cover opacity-25 scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-emerald/90 via-brand-emerald/95 to-brand-forest"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.25em] text-brand-gold">
        <span>Sacred Historical Heritage</span>
        <span>•</span>
        <span>Sunnah & Reflection</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-brand-ivory">
        The Blessed Ziyarat Guide
      </h1>

      <p class="max-w-2xl mx-auto text-sm sm:text-base text-brand-ivory/80 leading-relaxed font-light">
        Walking where the beloved Prophet Muhammad (peace be upon him) and his noble Companions walked. An authentic educational companion for your pilgrimage.
      </p>

      <!-- Quick Jump Buttons -->
      <div class="flex items-center justify-center gap-4 pt-4">
        <a
          href="#makkah-ziyarat"
          class="px-5 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-gold text-brand-emerald hover:brightness-110 transition-all shadow-sm"
        >
          Makkah Sites ({makkahSites.length})
        </a>
        <a
          href="#madinah-ziyarat"
          class="px-5 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-white/10 hover:bg-white/20 text-white border border-brand-gold/40 transition-all"
        >
          Madinah Sites ({madinahSites.length})
        </a>
      </div>
    </div>
  </section>

  <!-- Makkah Ziyarat Section -->
  <section id="makkah-ziyarat" class="py-20 bg-brand-ivory scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="border-b border-brand-gold/25 pb-4">
        <span class="text-xs uppercase font-mono tracking-[0.25em] text-brand-gold-dark font-semibold">
          Section 01
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-emerald mt-1">
          Sacred Ziyarat of Makkah al-Mukarramah
        </h2>
        <p class="text-xs text-brand-charcoal-muted mt-1">
          Historical landmarks visited during our guided morning and afternoon Makkah excursion circuits.
        </p>
      </div>

      <div class="space-y-12">
        {makkahSites.map((site) => (
          <div class="bg-white rounded-3xl overflow-hidden border border-brand-gold/20 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <div class="lg:col-span-5 h-72 lg:h-full relative min-h-[280px]">
              <img
                src={site.image}
                alt={site.name}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute bottom-4 left-4">
                <span class="font-arabic text-lg text-brand-gold-light bg-black/70 px-3 py-1 rounded-lg backdrop-blur-sm" dir="rtl">
                  {site.arabicName}
                </span>
              </div>
            </div>

            <div class="lg:col-span-7 p-6 sm:p-8 space-y-4">
              <h3 class="font-serif text-2xl font-bold text-brand-emerald">
                {site.name}
              </h3>
              
              <p class="text-xs text-brand-charcoal-light font-medium leading-relaxed">
                {site.short}
              </p>

              <div class="space-y-2 pt-2 border-t border-brand-ivory-dark">
                <span class="text-[11px] font-mono uppercase text-brand-gold-dark font-bold block">Religious & Historical Significance</span>
                <p class="text-xs text-brand-charcoal-muted leading-relaxed">
                  {site.significance}
                </p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs">
                <div class="p-3 rounded-xl bg-brand-ivory border border-brand-gold/15">
                  <span class="font-semibold text-brand-emerald block">Location:</span>
                  <span class="text-brand-charcoal-muted">{site.locationInfo}</span>
                </div>
                <div class="p-3 rounded-xl bg-brand-ivory border border-brand-gold/15">
                  <span class="font-semibold text-brand-emerald block">Pilgrim Guidance:</span>
                  <span class="text-brand-charcoal-muted">{site.practicalTips}</span>
                </div>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Madinah Ziyarat Section -->
  <section id="madinah-ziyarat" class="py-20 bg-brand-forest text-white scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="border-b border-brand-gold/25 pb-4">
        <span class="text-xs uppercase font-mono tracking-[0.25em] text-brand-gold font-semibold">
          Section 02
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mt-1">
          Sacred Ziyarat of Al-Madinah al-Munawwarah
        </h2>
        <p class="text-xs text-brand-ivory/80 mt-1">
          Sanctuaries of serenity and historic sites of the Prophet's community in Madinah.
        </p>
      </div>

      <div class="space-y-12">
        {madinahSites.map((site) => (
          <div class="bg-brand-emerald/70 rounded-3xl overflow-hidden border border-brand-gold/25 shadow-luxury grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <div class="lg:col-span-5 h-72 lg:h-full relative min-h-[280px]">
              <img
                src={site.image}
                alt={site.name}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute bottom-4 left-4">
                <span class="font-arabic text-lg text-brand-gold-light bg-black/70 px-3 py-1 rounded-lg backdrop-blur-sm" dir="rtl">
                  {site.arabicName}
                </span>
              </div>
            </div>

            <div class="lg:col-span-7 p-6 sm:p-8 space-y-4">
              <h3 class="font-serif text-2xl font-bold text-white">
                {site.name}
              </h3>
              
              <p class="text-xs text-brand-ivory/90 font-medium leading-relaxed">
                {site.short}
              </p>

              <div class="space-y-2 pt-2 border-t border-white/10">
                <span class="text-[11px] font-mono uppercase text-brand-gold font-bold block">Historical Significance</span>
                <p class="text-xs text-brand-ivory/80 leading-relaxed">
                  {site.significance}
                </p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs">
                <div class="p-3 rounded-xl bg-black/30 border border-brand-gold/20">
                  <span class="font-semibold text-brand-gold block">Location:</span>
                  <span class="text-brand-ivory/80">{site.locationInfo}</span>
                </div>
                <div class="p-3 rounded-xl bg-black/30 border border-brand-gold/20">
                  <span class="font-semibold text-brand-gold block">Pilgrim Guidance:</span>
                  <span class="text-brand-ivory/80">{site.practicalTips}</span>
                </div>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-16 bg-brand-ivory text-center">
    <div class="max-w-4xl mx-auto px-4 space-y-6">
      <h3 class="font-serif text-3xl font-bold text-brand-emerald">
        Experience Guided Ziyarat with Experienced Leaders
      </h3>
      <p class="text-xs sm:text-sm text-brand-charcoal-muted max-w-xl mx-auto leading-relaxed">
        All Iconic Travel & Tours group tours feature air-conditioned coach transfers and scholarly narrations at every sacred stop.
      </p>
      <div class="pt-2">
        <a
          href="/iconic-travel-tours/request-a-quote/"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full text-xs font-bold uppercase tracking-widest bg-brand-emerald text-brand-gold hover:bg-brand-forest shadow-md transition-all"
        >
          Book Your Package with Ziyarat Included
        </a>
      </div>
    </div>
  </section>

</Layout>
