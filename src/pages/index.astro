              class="w-full h-[420px] object-cover hover:scale-105 transition-transform duration-700"
            />
          </div>
        </div>

        <div class="lg:col-span-6 order-1 lg:order-2 space-y-6">
          <div class="inline-flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
            <span class="text-xs font-mono uppercase tracking-[0.25em] text-brand-gold">The City of Serenity</span>
          </div>

