---
import Layout from '../layouts/Layout.astro';
import faqs from '../data/faqs.json';

const categories = Array.from(new Set(faqs.map(f => f.category)));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<Layout
  title="Frequently Asked Questions (FAQ) | Iconic Travel & Tours (GL #5247)"
  description="Answers to common questions regarding Umrah packages, hotel distances to the Haram, high-speed train transit, Rawdah permits, and group support."
>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Header -->
  <section class="relative py-20 bg-brand-emerald text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/quran-rehal.jpg"
        alt="Holy Quran"
        class="w-full h-full object-cover opacity-20 scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-emerald/90 via-brand-emerald/95 to-brand-forest"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.25em] text-brand-gold">
        <span>Knowledge Base</span>
        <span>•</span>
        <span>Honest Answers</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-brand-ivory">
        Frequently Asked Questions
      </h1>

      <p class="max-w-2xl mx-auto text-sm sm:text-base text-brand-ivory/80 leading-relaxed font-light">
        Clear, transparent guidance on every stage of your holy journey with Iconic Travel & Tours (GL #5247).
      </p>

      <!-- Instant FAQ Search Input -->
      <div class="pt-4 max-w-xl mx-auto">
        <div class="relative">
          <input
            type="search"
            id="faq-search-input"
            placeholder="Search FAQs (e.g., hotels, Nusuk, payments, transport)..."
            class="w-full py-3.5 pl-12 pr-4 rounded-full bg-white text-brand-charcoal placeholder-brand-charcoal-muted/60 text-xs sm:text-sm border-2 border-brand-gold shadow-luxury focus:outline-none focus:ring-2 focus:ring-brand-gold"
          />
          <svg class="w-5 h-5 text-brand-gold absolute left-4 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Accordions by Category -->
  <section class="py-16 bg-brand-ivory">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      {categories.map((category) => {
        const catFaqs = faqs.filter(f => f.category === category);
        return (
          <div class="faq-category-block space-y-4">
            <div class="flex items-center gap-2 border-b border-brand-gold/25 pb-2">
              <span class="w-2 h-2 rounded-full bg-brand-gold-dark"></span>
              <h2 class="font-serif text-2xl font-bold text-brand-emerald">
                {category}
              </h2>
            </div>

            <div class="space-y-3">
              {catFaqs.map((faq, idx) => (
                <div class="faq-item bg-white rounded-2xl border border-brand-gold/20 shadow-sm overflow-hidden transition-all duration-200">
                  <button
                    type="button"
                    class="faq-toggle w-full p-5 text-left flex items-center justify-between gap-4 font-serif text-base sm:text-lg font-semibold text-brand-emerald hover:text-brand-gold-dark transition-colors"
                    aria-expanded="false"
                  >
                    <span class="faq-question-text">{faq.question}</span>
                    <span class="faq-icon text-brand-gold font-bold text-xl flex-shrink-0 transition-transform duration-300">+</span>
                  </button>

                  <div class="faq-content hidden px-5 pb-5 pt-1 text-xs sm:text-sm text-brand-charcoal-muted leading-relaxed border-t border-brand-ivory-dark">
                    <p class="faq-answer-text">{faq.answer}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );
      })}

      <!-- No FAQs Match State -->
      <div id="faq-no-results" class="hidden text-center py-12 bg-white rounded-2xl border border-brand-gold/20 p-8 space-y-3">
        <p class="font-serif text-xl text-brand-emerald">No questions match your search.</p>
        <p class="text-xs text-brand-charcoal-muted">Need personal assistance? Contact our Karachi customer support desk directly.</p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs font-bold uppercase bg-brand-gold text-brand-emerald"
        >
          Contact Support Desk
        </a>
      </div>

    </div>
  </section>

</Layout>

<script>
  // Accordion toggle
  const toggles = document.querySelectorAll<HTMLButtonElement>('.faq-toggle');

  toggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      const content = toggle.nextElementSibling as HTMLElement | null;
      const icon = toggle.querySelector('.faq-icon');

      if (!content || !icon) return;

      if (isExpanded) {
        toggle.setAttribute('aria-expanded', 'false');
        content.classList.add('hidden');
        icon.textContent = '+';
        icon.classList.remove('rotate-45');
      } else {
        toggle.setAttribute('aria-expanded', 'true');
        content.classList.remove('hidden');
        icon.textContent = '−';
      }
    });
  });

  // Live keyword search
  const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
  const faqItems = document.querySelectorAll<HTMLElement>('.faq-item');
  const catBlocks = document.querySelectorAll<HTMLElement>('.faq-category-block');
  const noResults = document.getElementById('faq-no-results');

  searchInput?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
    let totalVisible = 0;

    catBlocks.forEach(block => {
      const itemsInBlock = block.querySelectorAll<HTMLElement>('.faq-item');
      let blockVisibleCount = 0;

      itemsInBlock.forEach(item => {
        const question = item.querySelector('.faq-question-text')?.textContent?.toLowerCase() || '';
        const answer = item.querySelector('.faq-answer-text')?.textContent?.toLowerCase() || '';

        if (!q || question.includes(q) || answer.includes(q)) {
          item.style.display = 'block';
          blockVisibleCount++;
          totalVisible++;
          // auto expand if search query matches
          if (q) {
            const toggle = item.querySelector<HTMLButtonElement>('.faq-toggle');
            const content = item.querySelector<HTMLElement>('.faq-content');
            toggle?.setAttribute('aria-expanded', 'true');
            content?.classList.remove('hidden');
          }
        } else {
          item.style.display = 'none';
        }
      });

      if (blockVisibleCount === 0) {
        block.style.display = 'none';
      } else {
        block.style.display = 'block';
      }
    });

    if (noResults) {
      if (totalVisible === 0) noResults.classList.remove('hidden');
      else noResults.classList.add('hidden');
    }
  });
</script>
