---
import Layout from '../../layouts/Layout.astro';
import PackageCard from '../../components/PackageCard.astro';
import packages from '../../data/packages.json';

const categories = ['All Categories', 'Ramadan Special', 'Deluxe Family', 'Group Umrah', 'Economy Group', 'Tailored Private'];
const durations = ['All Durations', '10 Days', '12 Days', '14 Days', '15 Days', '21 Days'];
---

<Layout
  title="Umrah Packages 2026 / 1448 AH | Iconic Travel & Tours (GL #5247)"
  description="Explore verified Umrah packages from Pakistan. Executive Ramadan, Deluxe Family, and Signature Group tours with luxury accommodation in Makkah and Madinah."
>

  <!-- Hero Header -->
  <section class="relative py-20 bg-brand-emerald text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/iconic-travel-tours/images/hero-kaaba-tawaf.jpg"
        alt="Kaaba night prayer"
        class="w-full h-full object-cover opacity-20 scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-emerald/90 via-brand-emerald/95 to-brand-forest"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.25em] text-brand-gold">
        <span>Verified Offerings</span>
        <span>•</span>
        <span>Season 2026 / 1448 AH</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-brand-ivory">
        Discover Sacred Umrah Packages
      </h1>

      <p class="max-w-2xl mx-auto text-sm sm:text-base text-brand-ivory/80 leading-relaxed font-light">
        Carefully designed itineraries pairing close-proximity 5-star & 4-star hotels with attentive group coordination and high-speed intercity transportation.
      </p>

      <!-- Demonstration Compliance Pill -->
      <div class="pt-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] bg-brand-gold/15 text-brand-gold border border-brand-gold/30">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Demonstration Content — Exact rates verified upon direct client quotation
        </span>
      </div>
    </div>
  </section>

  <!-- Interactive Filter & Package Directory -->
  <section class="py-16 bg-brand-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <!-- Filter Bar -->
      <div class="bg-white p-6 rounded-2xl border border-brand-gold/20 shadow-sm space-y-4">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <h2 class="font-serif text-lg font-bold text-brand-emerald flex items-center gap-2">
            <svg class="w-5 h-5 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            <span>Filter Packages</span>
          </h2>
          <span id="package-count" class="text-xs font-mono text-brand-gold-dark font-semibold">
            Showing {packages.length} Packages
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
          <!-- Category Filter -->
          <div>
            <label for="filter-category" class="block text-xs font-semibold text-brand-charcoal mb-1">Category</label>
            <select id="filter-category" class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-3 focus:ring-brand-gold focus:border-brand-gold">
              {categories.map(c => <option value={c}>{c}</option>)}
            </select>
          </div>

          <!-- Duration Filter -->
          <div>
            <label for="filter-duration" class="block text-xs font-semibold text-brand-charcoal mb-1">Duration</label>
            <select id="filter-duration" class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-3 focus:ring-brand-gold focus:border-brand-gold">
              {durations.map(d => <option value={d}>{d}</option>)}
            </select>
          </div>

          <!-- Travel Type Filter -->
          <div>
            <label for="filter-type" class="block text-xs font-semibold text-brand-charcoal mb-1">Travel Style</label>
            <select id="filter-type" class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-3 focus:ring-brand-gold focus:border-brand-gold">
              <option value="All">All Travel Styles</option>
              <option value="Group">Group Tours</option>
              <option value="Family">Family Packages</option>
              <option value="Private">Private VIP</option>
            </select>
          </div>

          <!-- Reset Filter Button -->
          <div class="flex items-end">
            <button
              type="button"
              id="reset-filters-btn"
              class="w-full py-2.5 px-4 rounded-xl text-xs font-semibold uppercase tracking-wider bg-brand-forest text-brand-gold hover:bg-brand-emerald transition-colors"
            >
              Reset Filters
            </button>
          </div>
        </div>
      </div>

      <!-- Packages Grid -->
      <div id="packages-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {packages.map((pkg) => (
          <div
            class="package-item"
            data-category={pkg.category}
            data-duration={`${pkg.durationDays} Days`}
            data-type={pkg.travelType}
          >
            <PackageCard pkg={pkg} />
          </div>
        ))}
      </div>

      <!-- No packages fallback -->
      <div id="no-packages" class="hidden text-center py-16 bg-white rounded-2xl border border-brand-gold/20 p-8 space-y-4">
        <p class="font-serif text-xl text-brand-emerald">No packages match your chosen filters.</p>
        <p class="text-xs text-brand-charcoal-muted">Try resetting filters or request a bespoke quotation tailored to your exact dates.</p>
        <a
          href="/iconic-travel-tours/request-a-quote/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-gold text-brand-emerald"
        >
          Request Custom Itinerary
        </a>
      </div>

      <!-- Quick Package Booking & Inquiry Desk Section -->
      <div class="mt-20 bg-white rounded-3xl border border-brand-gold/30 shadow-luxury overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12">
          
          <!-- Left Column: Context & Direct Contact -->
          <div class="lg:col-span-5 bg-gradient-to-br from-brand-forest to-brand-emerald text-white p-8 sm:p-10 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <span class="text-xs font-mono uppercase tracking-widest text-brand-gold font-semibold">
                Official Reservations Desk
              </span>
              <h3 class="font-serif text-3xl font-bold text-brand-ivory leading-tight">
                Book or Enquire About Any Package
              </h3>
              <p class="text-xs text-brand-ivory/80 leading-relaxed">
                Whether you wish to reserve a signature Ramadan package, travel with your family, or arrange an executive customized itinerary, submit your details below. Our Karachi desk will respond promptly with confirmed dates and room allocations.
              </p>
            </div>

            <div class="space-y-3 pt-4 border-t border-brand-gold/20">
              <p class="text-xs font-semibold text-brand-gold">Instant Contact Hotlines (Karachi):</p>
              <div class="space-y-2 text-xs">
                <a
                  href="https://wa.me/923009222123?text=Assalamu%20Alaikum%20Iconic%20Travel%20%26%20Tours.%20I%20would%20like%20to%20inquire%20about%20Umrah%20packages."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 text-white hover:text-[#25D366] transition-colors"
                >
                  <svg class="w-4 h-4 fill-[#25D366]" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                  <span class="font-mono font-bold">WhatsApp: +92 300 9222123</span>
                </a>
                <p class="font-mono text-brand-ivory/70">Telephone: +92-332-2177752</p>
                <p class="font-mono text-brand-ivory/70">Coordinator: +92-321-9199999</p>
              </div>
            </div>
          </div>

          <!-- Right Column: Interactive Form -->
          <div class="lg:col-span-7 p-8 sm:p-10 space-y-4">
            <h4 class="font-serif text-xl font-bold text-brand-emerald">
              Package Reservation Inquiry Form
            </h4>

            <form id="packages-index-form" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="pi-name" class="block text-xs font-semibold text-brand-charcoal mb-1">Your Full Name *</label>
                  <input
                    type="text"
                    id="pi-name"
                    name="full_name"
                    required
                    placeholder="e.g. Tariq Mehmood"
                    class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-3 focus:ring-brand-gold focus:border-brand-gold"
                  />
                </div>
                <div>
                  <label for="pi-phone" class="block text-xs font-semibold text-brand-charcoal mb-1">WhatsApp / Mobile Number *</label>
                  <input
                    type="tel"
                    id="pi-phone"
                    name="phone"
                    required
                    placeholder="+92 300 1234567"
                    class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-3 focus:ring-brand-gold focus:border-brand-gold"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="pi-email" class="block text-xs font-semibold text-brand-charcoal mb-1">Email Address *</label>
                  <input
                    type="email"
                    id="pi-email"
                    name="email"
                    required
                    placeholder="tariq@example.com"
                    class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-3 focus:ring-brand-gold focus:border-brand-gold"
                  />
                </div>
                <div>
                  <label for="pi-package" class="block text-xs font-semibold text-brand-charcoal mb-1">Selected Umrah Package *</label>
                  <select id="pi-package" name="selected_package" class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-2">
                    {packages.map((p) => (
                      <option value={`${p.name} (${p.durationDays} Days)`}>
                        {p.name} — {p.durationDays} Days
                      </option>
                    ))}
                    <option value="Custom Bespoke Itinerary">Custom Bespoke Itinerary</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="pi-travelers" class="block text-xs font-semibold text-brand-charcoal mb-1">Number of Travelers *</label>
                  <select id="pi-travelers" name="travelers" class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-2">
                    <option value="1 Solo Pilgrim">1 Solo Pilgrim</option>
                    <option value="2 Pilgrims (Couple)">2 Pilgrims (Couple)</option>
                    <option value="3–4 Persons (Family)">3–4 Persons (Family)</option>
                    <option value="5+ Persons (Group Delegation)">5+ Persons (Group Delegation)</option>
                  </select>
                </div>
                <div>
                  <label for="pi-date" class="block text-xs font-semibold text-brand-charcoal mb-1">Preferred Travel Date / Season *</label>
                  <input
                    type="text"
                    id="pi-date"
                    name="preferred_date"
                    required
                    placeholder="e.g. Ramadan 2026, Oct 2026, or Dates"
                    class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-3 focus:ring-brand-gold focus:border-brand-gold"
                  />
                </div>
              </div>

              <div>
                <label for="pi-requirements" class="block text-xs font-semibold text-brand-charcoal mb-1">Additional Requirements</label>
                <textarea
                  id="pi-requirements"
                  name="requirements"
                  rows="2"
                  placeholder="Hotel preferences, room sharing, elder wheelchair assistance, or flights..."
                  class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2 px-3 focus:ring-brand-gold focus:border-brand-gold"
                ></textarea>
              </div>

              <div id="packages-form-status" class="hidden p-4 rounded-xl text-xs"></div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                <button
                  type="submit"
                  id="pi-submit-wa"
                  class="w-full py-3.5 px-4 rounded-xl text-xs font-bold uppercase tracking-wider bg-[#25D366] text-white hover:brightness-105 shadow-md transition-all flex items-center justify-center gap-2"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                  <span>Submit via WhatsApp</span>
                </button>
                <button
                  type="button"
                  id="pi-submit-email"
                  class="w-full py-3.5 px-4 rounded-xl text-xs font-bold uppercase tracking-wider bg-brand-emerald text-brand-gold hover:bg-brand-forest shadow-sm transition-all text-center"
                >
                  Submit via Email
                </button>
              </div>

              <p class="text-[11px] text-brand-charcoal-muted pt-1 text-center">
                Submissions are sent directly to WhatsApp <strong>+92 300 9222123</strong> and <strong>inquiry@iconictravelandtours.com</strong>.
              </p>
            </form>
          </div>

        </div>
      </div>

    </div>
  </section>

</Layout>

<script>
  // Filter logic
  const categorySelect = document.getElementById('filter-category') as HTMLSelectElement | null;
  const durationSelect = document.getElementById('filter-duration') as HTMLSelectElement | null;
  const typeSelect = document.getElementById('filter-type') as HTMLSelectElement | null;
  const resetBtn = document.getElementById('reset-filters-btn');
  const countSpan = document.getElementById('package-count');
  const items = document.querySelectorAll<HTMLElement>('.package-item');
  const noPackages = document.getElementById('no-packages');

  const applyFilters = () => {
    const selectedCategory = categorySelect?.value || 'All Categories';
    const selectedDuration = durationSelect?.value || 'All Durations';
    const selectedType = typeSelect?.value || 'All';

    let visibleCount = 0;

    items.forEach(item => {
      const cat = item.dataset.category || '';
      const dur = item.dataset.duration || '';
      const typ = item.dataset.type || '';

      const matchCategory = selectedCategory === 'All Categories' || cat === selectedCategory;
      const matchDuration = selectedDuration === 'All Durations' || dur === selectedDuration;
      const matchType = selectedType === 'All' || typ.toLowerCase().includes(selectedType.toLowerCase());

      if (matchCategory && matchDuration && matchType) {
        item.style.display = 'block';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    if (countSpan) countSpan.textContent = `Showing ${visibleCount} Packages`;
    if (noPackages) {
      if (visibleCount === 0) noPackages.classList.remove('hidden');
      else noPackages.classList.add('hidden');
    }
  };

  categorySelect?.addEventListener('change', applyFilters);
  durationSelect?.addEventListener('change', applyFilters);
  typeSelect?.addEventListener('change', applyFilters);

  resetBtn?.addEventListener('click', () => {
    if (categorySelect) categorySelect.value = 'All Categories';
    if (durationSelect) durationSelect.value = 'All Durations';
    if (typeSelect) typeSelect.value = 'All';
    applyFilters();
  });

  // Package booking inquiry form logic
  const piForm = document.getElementById('packages-index-form') as HTMLFormElement | null;
  const piStatus = document.getElementById('packages-form-status');
  const piBtnEmail = document.getElementById('pi-submit-email');

  const getPiData = () => {
    if (!piForm) return null;
    const fd = new FormData(piForm);
    const fullName = (fd.get('full_name') as string || '').trim();
    const phone = (fd.get('phone') as string || '').trim();
    const email = (fd.get('email') as string || '').trim();
    const pkg = (fd.get('selected_package') as string || '').trim();
    const travelers = (fd.get('travelers') as string || '').trim();
    const preferredDate = (fd.get('preferred_date') as string || '').trim();
    const requirements = (fd.get('requirements') as string || '').trim() || 'None';

    return { fullName, phone, email, pkg, travelers, preferredDate, requirements };
  };

  const validatePiData = (data: ReturnType<typeof getPiData>) => {
    if (!data) return false;
    if (!data.fullName) {
      alert('Please enter your full name.');
      return false;
    }
    if (!data.phone) {
      alert('Please enter your WhatsApp or mobile number.');
      return false;
    }
    if (!data.email || !data.email.includes('@')) {
      alert('Please enter a valid email address.');
      return false;
    }
    if (!data.preferredDate) {
      alert('Please enter your preferred travel date.');
      return false;
    }
    return true;
  };

  const submitPi = (mode: 'wa' | 'email') => {
    const data = getPiData();
    if (!validatePiData(data) || !data || !piStatus) return;

    const summary = `Assalamu Alaikum Iconic Travel & Tours.\nUmrah Package Booking Inquiry:\n• Package: ${data.pkg}\n• Full Name: ${data.fullName}\n• WhatsApp/Mobile: ${data.phone}\n• Email: ${data.email}\n• Number of Travelers: ${data.travelers}\n• Preferred Date: ${data.preferredDate}\n• Requirements: ${data.requirements}`;
    const waUrl = `https://wa.me/923009222123?text=${encodeURIComponent(summary)}`;
    const mailtoUrl = `mailto:inquiry@iconictravelandtours.com?subject=${encodeURIComponent(`Umrah Booking: ${data.pkg} - ${data.fullName}`)}&body=${encodeURIComponent(summary)}`;

    if (mode === 'wa') {
      window.open(waUrl, '_blank', 'noopener,noreferrer');
    } else {
      window.location.href = mailtoUrl;
    }

    piStatus.classList.remove('hidden');
    piStatus.className = 'p-4 rounded-xl text-xs bg-emerald-50 border border-emerald-300 text-emerald-950 space-y-2';
    piStatus.innerHTML = `
      <div class="flex items-center gap-1.5 font-bold text-emerald-900">
        <svg class="w-4 h-4 text-emerald-600 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        <span>Inquiry Prepared & Forwarded!</span>
      </div>
      <p>Thank you, <strong>${data.fullName}</strong>. Your enquiry for <strong>${data.pkg}</strong> has been compiled for our Karachi reservations desk.</p>
      <div class="flex flex-wrap gap-2 pt-1">
        <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-[#25D366] text-white font-bold hover:brightness-105">
          <span>Open WhatsApp (+92 300 9222123)</span>
        </a>
        <a href="${mailtoUrl}" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-brand-emerald text-brand-gold font-bold hover:bg-brand-forest">
          <span>Send via Email</span>
        </a>
      </div>
      <p class="text-[10px] text-emerald-800/80 pt-1 leading-tight">
        <strong>Direct Delivery Notice:</strong> Inquiries are sent directly to our official WhatsApp desk (+92 300 9222123) and inquiry@iconictravelandtours.com for immediate human response.
      </p>
    `;
  };

  piForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    submitPi('wa');
  });

  piBtnEmail?.addEventListener('click', () => {
    submitPi('email');
  });
</script>
