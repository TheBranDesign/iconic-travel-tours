---
import Layout from '../../layouts/Layout.astro';
import packages from '../../data/packages.json';
import company from '../../data/company.json';

export async function getStaticPaths() {
  return packages.map((pkg) => ({
    params: { slug: pkg.slug },
    props: { pkg }
  }));
}

const { pkg } = Astro.props;
const whatsappInquiryUrl = `https://wa.me/${company.primaryWhatsApp}?text=${encodeURIComponent(`Assalamu Alaikum. I am interested in inquiring about the "${pkg.name}" (${pkg.durationDays} Days) package.`)}`;
---

<Layout
  title={`${pkg.name} | Iconic Travel & Tours (GL #5247)`}
  description={`${pkg.name} — ${pkg.durationDays} Days Umrah package. Includes ${pkg.makkahNights} nights Makkah (${pkg.makkahHotel}) and ${pkg.madinahNights} nights Madinah.`}
  image={pkg.heroImage}
>

  <!-- Large Cinematic Hero Banner -->
  <section class="relative min-h-[55vh] flex items-end bg-brand-emerald overflow-hidden pb-16">
    <div class="absolute inset-0 z-0">
      <img
        src={pkg.heroImage}
        alt={pkg.name}
        class="w-full h-full object-cover scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-forest via-brand-emerald/80 to-black/50"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-white space-y-4">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-mono text-brand-gold-light" aria-label="Breadcrumb">
        <a href="/iconic-travel-tours/" class="hover:underline">Home</a>
        <span>/</span>
        <a href="/iconic-travel-tours/umrah-packages/" class="hover:underline">Umrah Packages</a>
        <span>/</span>
        <span class="text-white font-semibold">{pkg.name}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-3">
        <span class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-gold text-brand-emerald shadow-sm">
          {pkg.category}
        </span>
        {pkg.tag && (
          <span class="px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-brand-red text-white">
            {pkg.tag}
          </span>
        )}
        <span class="px-3 py-1 rounded-full text-xs font-mono bg-white/20 text-white backdrop-blur-sm border border-white/20">
          Season: {pkg.departureMonth}
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-white max-w-4xl leading-tight">
        {pkg.name}
      </h1>

      <p class="max-w-2xl text-sm sm:text-base text-brand-ivory/85 leading-relaxed">
        {pkg.overview}
      </p>
    </div>
  </section>

  <!-- Main Content & Sticky Inquiry Sidebar -->
  <section class="py-16 bg-brand-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left 8 Columns: Package Content Details -->
        <div class="lg:col-span-8 space-y-12">
          
          <!-- Key Package Highlights Quick Grid -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-brand-gold/20 shadow-sm grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
            <div>
              <span class="block text-xs font-mono uppercase text-brand-charcoal-muted">Total Duration</span>
              <span class="font-serif text-2xl font-bold text-brand-emerald">{pkg.durationDays} Days</span>
            </div>
            <div>
              <span class="block text-xs font-mono uppercase text-brand-charcoal-muted">Makkah Nights</span>
              <span class="font-serif text-2xl font-bold text-brand-emerald">{pkg.makkahNights} Nights</span>
            </div>
            <div>
              <span class="block text-xs font-mono uppercase text-brand-charcoal-muted">Madinah Nights</span>
              <span class="font-serif text-2xl font-bold text-brand-emerald">{pkg.madinahNights} Nights</span>
            </div>
            <div>
              <span class="block text-xs font-mono uppercase text-brand-charcoal-muted">Availability</span>
              <span class="font-serif text-sm font-bold text-brand-gold-dark mt-2 block">{pkg.availability}</span>
            </div>
          </div>

          <!-- Hotel Accommodation Section -->
          <div class="space-y-4">
            <h2 class="font-serif text-2xl font-bold text-brand-emerald border-b border-brand-gold/20 pb-3">
              Accommodation & Logistics
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="bg-white p-6 rounded-2xl border border-brand-gold/20 space-y-2">
                <span class="text-xs font-mono uppercase tracking-wider text-brand-gold-dark font-semibold">Makkah Sanctuary</span>
                <h3 class="font-serif text-lg font-bold text-brand-emerald">{pkg.makkahHotel}</h3>
                <p class="text-xs text-brand-charcoal-muted leading-relaxed">
                  Carefully selected for effortless walking proximity to the Grand Mosque courtyard. Daily breakfast buffet included.
                </p>
              </div>

              <div class="bg-white p-6 rounded-2xl border border-brand-gold/20 space-y-2">
                <span class="text-xs font-mono uppercase tracking-wider text-brand-gold-dark font-semibold">Madinah Sanctuary</span>
                <h3 class="font-serif text-lg font-bold text-brand-emerald">{pkg.madinahHotel}</h3>
                <p class="text-xs text-brand-charcoal-muted leading-relaxed">
                  Positioned in the prime central Markazia district directly bordering the Prophet's Mosque courtyard and ladies' prayer gates.
                </p>
              </div>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-brand-gold/20 flex items-center gap-4">
              <div class="w-10 h-10 rounded-full bg-brand-emerald/10 text-brand-emerald flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
              </div>
              <div class="text-xs">
                <span class="font-bold text-brand-emerald block text-sm">Ground Transportation Standard</span>
                <span class="text-brand-charcoal-muted">{pkg.transport}</span>
              </div>
            </div>
          </div>

          <!-- Day-by-Day Itinerary -->
          <div class="space-y-6">
            <h2 class="font-serif text-2xl font-bold text-brand-emerald border-b border-brand-gold/20 pb-3">
              Detailed Day-by-Day Itinerary
            </h2>

            <div class="space-y-4">
              {pkg.itinerary.map((item) => (
                <div class="bg-white p-6 rounded-2xl border border-brand-gold/20 shadow-sm flex flex-col sm:flex-row sm:items-start gap-4">
                  <span class="w-20 font-serif text-lg font-bold text-brand-gold-dark flex-shrink-0">
                    Day {item.day}
                  </span>
                  <div class="space-y-1">
                    <h3 class="font-serif text-base font-bold text-brand-emerald">{item.title}</h3>
                    <p class="text-xs text-brand-charcoal-muted leading-relaxed">{item.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Included and Excluded Services -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Included -->
            <div class="bg-white p-6 rounded-2xl border border-brand-gold/20 space-y-4">
              <h3 class="font-serif text-lg font-bold text-brand-emerald flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-green-500"></span>
                <span>Services Included</span>
              </h3>
              <ul class="space-y-2.5 text-xs text-brand-charcoal-muted">
                {pkg.included.map((inc) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{inc}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Excluded -->
            <div class="bg-white p-6 rounded-2xl border border-brand-gold/20 space-y-4">
              <h3 class="font-serif text-lg font-bold text-brand-emerald flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-red-400"></span>
                <span>Services Excluded</span>
              </h3>
              <ul class="space-y-2.5 text-xs text-brand-charcoal-muted">
                {pkg.excluded.map((exc) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-red-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    <span>{exc}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

        </div>


        <!-- Right 4 Columns: Sticky Booking & Inquiry Card -->
        <div class="lg:col-span-4 space-y-6">
          <div class="sticky top-28 bg-white rounded-3xl p-6 sm:p-8 border border-brand-gold/30 shadow-luxury space-y-6">
            
            <div class="border-b border-brand-gold/20 pb-4">
              <span class="text-[10px] font-mono uppercase tracking-wider text-brand-gold-dark font-semibold">
                Transparent Pricing Standard
              </span>
              <div class="font-serif text-2xl sm:text-3xl font-bold text-brand-emerald mt-1">
                {pkg.pricePlaceholder}
              </div>
              <p class="text-[11px] text-brand-charcoal-muted mt-1 leading-snug">
                {pkg.priceNote || "Rates vary according to airline booking class and hotel room occupancy."}
              </p>
            </div>

            <!-- Direct Package Booking & Inquiry Form -->
            <form class="space-y-3.5" id="package-inquiry-form">
              <input type="hidden" id="p-pkg-name" name="package_name" value={pkg.name} />
              <input type="hidden" id="p-pkg-duration" name="duration" value={`${pkg.durationDays} Days`} />

              <div class="p-2.5 rounded-xl bg-brand-ivory border border-brand-gold/20 text-xs text-brand-emerald font-semibold flex items-center justify-between">
                <span>Selected: <strong>{pkg.name}</strong></span>
                <span class="text-brand-gold-dark font-mono text-[11px]">{pkg.durationDays} Days</span>
              </div>

              <div>
                <label for="p-name" class="block text-xs font-semibold text-brand-charcoal mb-1">Your Full Name *</label>
                <input
                  type="text"
                  id="p-name"
                  name="full_name"
                  required
                  placeholder="e.g. Tariq Mehmood"
                  class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-3 focus:ring-brand-gold focus:border-brand-gold"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="p-phone" class="block text-xs font-semibold text-brand-charcoal mb-1">WhatsApp / Mobile *</label>
                  <input
                    type="tel"
                    id="p-phone"
                    name="phone"
                    required
                    placeholder="+92 300 1234567"
                    class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-3 focus:ring-brand-gold focus:border-brand-gold"
                  />
                </div>
                <div>
                  <label for="p-email" class="block text-xs font-semibold text-brand-charcoal mb-1">Email Address *</label>
                  <input
                    type="email"
                    id="p-email"
                    name="email"
                    required
                    placeholder="tariq@example.com"
                    class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-3 focus:ring-brand-gold focus:border-brand-gold"
                  />
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="p-travelers" class="block text-xs font-semibold text-brand-charcoal mb-1">Travelers *</label>
                  <select id="p-travelers" name="travelers" class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-2">
                    <option value="1 Person (Solo Pilgrim)">1 Person (Solo)</option>
                    <option value="2 Persons (Couple)">2 Persons (Couple)</option>
                    <option value="3–4 Persons (Family)">3–4 Persons (Family)</option>
                    <option value="5+ Persons (Group Delegation)">5+ Persons (Group)</option>
                  </select>
                </div>
                <div>
                  <label for="p-room" class="block text-xs font-semibold text-brand-charcoal mb-1">Room Sharing</label>
                  <select id="p-room" name="room_sharing" class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-2">
                    <option value="Double Sharing">Double Room</option>
                    <option value="Triple Sharing">Triple Room</option>
                    <option value="Quad Sharing">Quad Room</option>
                    <option value="Private Family Suite">Family Suite</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="p-date" class="block text-xs font-semibold text-brand-charcoal mb-1">Preferred Travel Date / Season *</label>
                <input
                  type="text"
                  id="p-date"
                  name="preferred_date"
                  required
                  placeholder="e.g. 15 Oct 2026, Ramadan, or Flexible"
                  class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2.5 px-3 focus:ring-brand-gold focus:border-brand-gold"
                />
              </div>

              <div>
                <label for="p-requirements" class="block text-xs font-semibold text-brand-charcoal mb-1">Additional Requirements</label>
                <textarea
                  id="p-requirements"
                  name="requirements"
                  rows="2"
                  placeholder="Wheelchair assistance, Haram view preference, airline choice, or infant cot..."
                  class="w-full text-xs rounded-xl border-brand-gold/30 bg-brand-ivory/50 text-brand-charcoal py-2 px-3 focus:ring-brand-gold focus:border-brand-gold"
                ></textarea>
              </div>

              <!-- Real-time Status Notice Box -->
              <div id="package-form-status" class="hidden p-4 rounded-xl text-xs"></div>

              <!-- Primary Action: WhatsApp Direct Booking -->
              <button
                type="submit"
                id="p-submit-wa"
                class="w-full py-3.5 px-4 rounded-xl text-xs font-bold uppercase tracking-wider bg-[#25D366] text-white hover:brightness-105 shadow-md transition-all flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                <span>Book / Inquire on WhatsApp</span>
              </button>

              <!-- Secondary Action: Email Booking Desk -->
              <button
                type="button"
                id="p-submit-email"
                class="w-full py-3 px-4 rounded-xl text-xs font-bold uppercase tracking-wider bg-brand-emerald text-brand-gold hover:bg-brand-forest shadow-sm transition-all text-center"
              >
                Inquire via Email / Desk
              </button>
            </form>

            <div class="pt-2 text-center">
              <span class="text-[11px] text-brand-charcoal-muted">Quick 1-click inquiry:</span>
              <a
                href={whatsappInquiryUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-1 w-full flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs font-semibold text-[#25D366] hover:bg-[#25D366]/10 border border-[#25D366]/40 transition-all"
              >
                <span>Instant WhatsApp Chat (+92 300 9222123)</span>
              </a>
            </div>

            <!-- Verified Contact Hotline numbers -->
            <div class="pt-4 border-t border-brand-gold/15 text-center text-xs text-brand-charcoal-muted space-y-1">
              <p class="font-semibold text-brand-emerald">Iconic Reservation Desk (Karachi):</p>
              <p>
                <a href="https://wa.me/923009222123" target="_blank" rel="noopener noreferrer" class="hover:underline font-mono text-[#25D366] font-bold">
                  WhatsApp: +92 300 9222123
                </a>
              </p>
              <p><a href="tel:+923322177752" class="hover:underline font-mono">Direct: +92-332-2177752</a></p>
              <p><a href="tel:+923219199999" class="hover:underline font-mono">Coordinator: +92-321-9199999</a></p>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>

</Layout>

<script>
  const pForm = document.getElementById('package-inquiry-form') as HTMLFormElement | null;
  const pStatus = document.getElementById('package-form-status');
  const pBtnWA = document.getElementById('p-submit-wa');
  const pBtnEmail = document.getElementById('p-submit-email');

  const getPackageFormData = () => {
    if (!pForm) return null;
    const formData = new FormData(pForm);
    const fullName = (formData.get('full_name') as string || '').trim();
    const phone = (formData.get('phone') as string || '').trim();
    const email = (formData.get('email') as string || '').trim();
    const pkgName = formData.get('package_name') as string;
    const duration = formData.get('duration') as string;
    const travelers = formData.get('travelers') as string;
    const roomSharing = formData.get('room_sharing') as string;
    const preferredDate = (formData.get('preferred_date') as string || '').trim();
    const requirements = (formData.get('requirements') as string || '').trim() || 'None';

    return { fullName, phone, email, pkgName, duration, travelers, roomSharing, preferredDate, requirements };
  };

  const validatePackageForm = (data: ReturnType<typeof getPackageFormData>) => {
    if (!data) return false;
    if (!data.fullName) {
      alert('Please enter your full name.');
      return false;
    }
    if (!data.phone) {
      alert('Please enter your WhatsApp or mobile number.');
      return false;
    }
    if (!data.email || !data.email.includes('@')) {
      alert('Please enter a valid email address.');
      return false;
    }
    if (!data.preferredDate) {
      alert('Please enter your preferred travel date or season.');
      return false;
    }
    return true;
  };

  const buildSummary = (data: NonNullable<ReturnType<typeof getPackageFormData>>) => {
    return `Assalamu Alaikum Iconic Travel & Tours.\nI would like to book / inquire about an Umrah Package:\n• Package: ${data.pkgName} (${data.duration})\n• Full Name: ${data.fullName}\n• WhatsApp/Mobile: ${data.phone}\n• Email: ${data.email}\n• Number of Travelers: ${data.travelers}\n• Room Sharing: ${data.roomSharing}\n• Preferred Travel Date: ${data.preferredDate}\n• Additional Requirements: ${data.requirements}`;
  };

  const handleBookingSubmission = (mode: 'wa' | 'email') => {
    const data = getPackageFormData();
    if (!validatePackageForm(data) || !data || !pStatus) return;

    const summary = buildSummary(data);
    const waUrl = `https://wa.me/923009222123?text=${encodeURIComponent(summary)}`;
    const mailtoUrl = `mailto:inquiry@iconictravelandtours.com?subject=${encodeURIComponent(`Umrah Booking Inquiry: ${data.pkgName} - ${data.fullName}`)}&body=${encodeURIComponent(summary)}`;

    if (mode === 'wa') {
      window.open(waUrl, '_blank', 'noopener,noreferrer');
    } else {
      window.location.href = mailtoUrl;
    }

    pStatus.classList.remove('hidden');
    pStatus.className = 'p-4 rounded-xl text-xs bg-emerald-50 border border-emerald-300 text-emerald-950 space-y-2';
    pStatus.innerHTML = `
      <div class="flex items-center gap-1.5 font-bold text-emerald-900">
        <svg class="w-4 h-4 text-emerald-600 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        <span>Booking Details Prepared!</span>
      </div>
      <p>Thank you, <strong>${data.fullName}</strong>. Your request for <strong>${data.pkgName}</strong> has been compiled for our Karachi reservation desk.</p>
      <div class="flex flex-wrap gap-2 pt-1">
        <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-[#25D366] text-white font-bold hover:brightness-105">
          <span>Open WhatsApp (+92 300 9222123)</span>
        </a>
        <a href="${mailtoUrl}" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-brand-emerald text-brand-gold font-bold hover:bg-brand-forest">
          <span>Send via Email</span>
        </a>
      </div>
      <p class="text-[10px] text-emerald-800/80 pt-1 leading-tight">
        <strong>Direct Delivery Notice:</strong> Submissions are routed directly to our reservations desk on WhatsApp (+92 300 9222123) and inquiry@iconictravelandtours.com for prompt human review.
      </p>
    `;
  };

  pForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    handleBookingSubmission('wa');
  });

  pBtnEmail?.addEventListener('click', () => {
    handleBookingSubmission('email');
  });
</script>
