---
import Layout from '../../layouts/Layout.astro';
import PackageCard from '../../components/PackageCard.astro';
import destinations from '../../data/destinations.json';
import packages from '../../data/packages.json';

export async function getStaticPaths() {
  return destinations.map((dest) => ({
    params: { slug: dest.slug },
    props: { dest }
  }));
}

const { dest } = Astro.props;
const relatedPackages = packages.filter(p => dest.relatedPackages?.includes(p.slug));
---

<Layout
  title={`${dest.name} | Iconic Travel & Tours Destination Guide`}
  description={dest.intro}
  image={dest.heroImage}
>

  <!-- Large Full-Width Destination Hero -->
  <section class="relative min-h-[60vh] flex items-end bg-brand-emerald overflow-hidden pb-16">
    <div class="absolute inset-0 z-0">
      <img
        src={dest.heroImage}
        alt={dest.name}
        class="w-full h-full object-cover scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-forest via-brand-emerald/80 to-black/50"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-white space-y-4">
      <nav class="flex items-center gap-2 text-xs font-mono text-brand-gold-light" aria-label="Breadcrumb">
        <a href="/" class="hover:underline">Home</a>
        <span>/</span>
        <a href="/destinations" class="hover:underline">Destinations</a>
        <span>/</span>
        <span class="text-white font-semibold">{dest.name}</span>
      </nav>

      <span class="font-arabic text-3xl sm:text-4xl text-brand-gold block" dir="rtl">
        {dest.arabicTitle}
      </span>

      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-white max-w-4xl leading-tight">
        {dest.name}
      </h1>

      <p class="text-xs sm:text-sm font-mono uppercase tracking-widest text-brand-gold-light">
        {dest.tagline}
      </p>
    </div>
  </section>

  <!-- Overview & Spiritual Atmosphere -->
  <section class="py-20 bg-brand-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs uppercase font-mono tracking-[0.25em] text-brand-gold-dark font-semibold">
            Destination Overview
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-emerald">
            The Atmosphere of {dest.name}
          </h2>
          <p class="text-base text-brand-charcoal-light leading-relaxed">
            {dest.intro}
          </p>
          <div class="p-6 rounded-2xl bg-white border border-brand-gold/20 shadow-sm space-y-2">
            <h4 class="font-serif text-base font-bold text-brand-emerald">Spiritual Essence & Character:</h4>
            <p class="text-xs text-brand-charcoal-muted leading-relaxed">
              {dest.atmosphere}
            </p>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-4">
          <div class="bg-brand-forest text-white p-8 rounded-3xl border border-brand-gold/30 shadow-luxury space-y-4">
            <h3 class="font-serif text-xl font-bold text-brand-gold">Iconic Highlights:</h3>
            <ul class="space-y-3 text-xs text-brand-ivory/85">
              {dest.highlights.map((hl) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-brand-gold font-bold">✓</span>
                  <span>{hl}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Sacred Landmarks Showcase -->
      <div class="space-y-8">
        <div class="border-b border-brand-gold/20 pb-4">
          <span class="text-xs uppercase font-mono tracking-[0.25em] text-brand-gold-dark font-semibold">
            Sacred Geography
          </span>
          <h2 class="font-serif text-3xl font-bold text-brand-emerald mt-1">
            Important Landmarks in {dest.name}
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {dest.landmarks.map((lm) => (
            <div class="bg-white rounded-3xl overflow-hidden border border-brand-gold/20 shadow-sm flex flex-col group">
              <div class="relative h-60 overflow-hidden bg-brand-forest">
                <img
                  src={lm.image}
                  alt={lm.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
              </div>
              <div class="p-6 space-y-2">
                <h3 class="font-serif text-xl font-bold text-brand-emerald">{lm.name}</h3>
                <p class="text-xs text-brand-charcoal-muted leading-relaxed">{lm.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Travel Guidance & Practical Protocol -->
      <div class="bg-white p-8 sm:p-10 rounded-3xl border border-brand-gold/25 shadow-sm space-y-4">
        <h3 class="font-serif text-2xl font-bold text-brand-emerald flex items-center gap-2">
          <svg class="w-6 h-6 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Travel Guidance & Sacred Protocol</span>
        </h3>
        <p class="text-sm text-brand-charcoal-light leading-relaxed">
          {dest.guidance}
        </p>
      </div>

      <!-- Companion Packages for this Destination -->
      {relatedPackages.length > 0 && (
        <div class="space-y-8 pt-8">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs uppercase font-mono tracking-[0.2em] text-brand-gold-dark font-semibold">
                Available Tours
              </span>
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-emerald">
                Packages Featuring {dest.name}
              </h2>
            </div>
            <a
              href="/umrah-packages"
              class="text-xs font-bold uppercase tracking-wider text-brand-gold-dark hover:underline"
            >
              View All Packages →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {relatedPackages.map((pkg) => (
              <PackageCard pkg={pkg} />
            ))}
          </div>
        </div>
      )}

      <!-- Bottom Inquiry CTA -->
      <div class="rounded-3xl p-8 bg-brand-emerald text-white text-center space-y-4">
        <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white">
          Plan Your Blessed Visit to {dest.name}
        </h3>
        <p class="text-xs sm:text-sm text-brand-ivory/80 max-w-xl mx-auto">
          Our Karachi consultants coordinate visas, hotels, private vehicles, and guided tours.
        </p>
        <div class="pt-2">
          <a
            href="/request-a-quote"
            class="inline-flex items-center gap-2 px-8 py-3 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-gold text-brand-emerald hover:brightness-110 shadow-md transition-all"
          >
            Request Custom Quotation
          </a>
        </div>
      </div>

    </div>
  </section>

</Layout>
