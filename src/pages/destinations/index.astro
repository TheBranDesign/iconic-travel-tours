---
import Layout from '../../layouts/Layout.astro';
import destinations from '../../data/destinations.json';
---

<Layout
  title="Destinations | Iconic Travel & Tours (GL #5247)"
  description="Discover the sacred and historic cities of Saudi Arabia: Makkah al-Mukarramah, Al-Madinah al-Munawwarah, and Jeddah the Gateway."
>

  <!-- Hero Header -->
  <section class="relative py-20 bg-brand-emerald text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/makkah-panoramic.jpg"
        alt="Sacred destinations"
        class="w-full h-full object-cover opacity-20 scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-emerald/90 via-brand-emerald/95 to-brand-forest"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.25em] text-brand-gold">
        <span>Sacred Geography</span>
        <span>•</span>
        <span>The Blessed Lands</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-brand-ivory">
        Destinations of Faith & Heritage
      </h1>

      <p class="max-w-2xl mx-auto text-sm sm:text-base text-brand-ivory/80 leading-relaxed font-light">
        Experience the profound beauty of Makkah and Madinah before your journey begins. Discover their landmarks, spiritual etiquette, and companion packages.
      </p>
    </div>
  </section>

  <!-- Destinations Discovery Cards Grid -->
  <section class="py-20 bg-brand-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {destinations.map((dest) => (
          <article class="bg-white rounded-3xl overflow-hidden border border-brand-gold/20 shadow-luxury hover:shadow-luxury-lg transition-all duration-300 flex flex-col group">
            
            <div class="relative h-72 overflow-hidden bg-brand-forest">
              <img
                src={dest.cardImage || dest.heroImage}
                alt={dest.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
              
              <div class="absolute bottom-4 left-6 right-6 text-white">
                <span class="font-arabic text-xl text-brand-gold-light block" dir="rtl">
                  {dest.arabicTitle}
                </span>
                <h3 class="font-serif text-2xl font-bold text-white mt-1">
                  {dest.name}
                </h3>
              </div>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between space-y-6">
              <div class="space-y-3">
                <span class="text-[11px] font-mono text-brand-gold-dark uppercase tracking-wider block font-semibold">
                  {dest.tagline}
                </span>
                <p class="text-xs text-brand-charcoal-muted leading-relaxed line-clamp-3">
                  {dest.intro}
                </p>
              </div>

              <!-- Landmark count pill -->
              <div class="pt-4 border-t border-brand-ivory-dark flex items-center justify-between">
                <span class="text-xs text-brand-charcoal font-medium">
                  {dest.landmarks.length} Historic Landmarks
                </span>
                <a
                  href={`/destinations/${dest.slug}`}
                  class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-brand-emerald hover:text-brand-gold-dark transition-colors"
                >
                  <span>Explore Destination</span>
                  <span>→</span>
                </a>
              </div>
            </div>

          </article>
        ))}
      </div>

      <!-- Configurable Future International Extensions Notice -->
      <div class="p-8 rounded-3xl bg-white border border-brand-gold/30 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2">
          <span class="text-[10px] font-mono uppercase tracking-widest text-brand-gold-dark font-semibold">
            Bespoke Extensions
          </span>
          <h3 class="font-serif text-xl font-bold text-brand-emerald">
            Looking for Multi-Destination Islamic Heritage Travel?
          </h3>
          <p class="text-xs text-brand-charcoal-muted max-w-xl">
            We coordinate combined itineraries extending from Saudi Arabia to Turkey, Jordan, and Uzbekistan upon custom request for family delegations and scholarly groups.
          </p>
        </div>
        <a
          href="/request-a-quote"
          class="px-6 py-3 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-emerald text-brand-gold hover:bg-brand-forest transition-colors whitespace-nowrap"
        >
          Request Custom Itinerary
        </a>
      </div>

    </div>
  </section>

</Layout>
