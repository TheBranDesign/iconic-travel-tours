---
import Layout from '../layouts/Layout.astro';
import services from '../data/services.json';
import company from '../data/company.json';
---

<Layout
  title="Our Services | Iconic Travel & Tours (GL #5247)"
  description="Comprehensive Umrah travel arrangements, group travel management, hotel booking, VIP transportation, guided Ziyarat, and 24/7 dedicated group assistance."
>

  <!-- Hero Header -->
  <section class="relative py-20 bg-brand-emerald text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/iconic-travel-tours/images/luxury-hotel-suite.jpg"
        alt="Luxury hospitality suite"
        class="w-full h-full object-cover opacity-20 scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-emerald/90 via-brand-emerald/95 to-brand-forest"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.25em] text-brand-gold">
        <span>Complete Hospitality Solutions</span>
        <span>•</span>
        <span>Karachi to the Two Holy Harams</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-brand-ivory">
        Excellence in Pilgrimage Services
      </h1>

      <p class="max-w-2xl mx-auto text-sm sm:text-base text-brand-ivory/80 leading-relaxed font-light">
        Every service is engineered around one foundational promise: Your Comfort, Our Priority. Licensed under GL #5247.
      </p>
    </div>
  </section>

  <!-- Detailed Service Sections -->
  <section class="py-20 bg-brand-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24">
      
      {services.map((svc, index) => {
        const isEven = index % 2 === 1;
        return (
          <div id={svc.slug} class="scroll-mt-28 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            
            <!-- Image Column -->
            <div class={`lg:col-span-5 relative ${isEven ? 'order-1 lg:order-2' : ''}`}>
              <div class="rounded-3xl overflow-hidden shadow-luxury-lg border border-brand-gold/30">
                <img
                  src={svc.image}
                  alt={svc.title}
                  class="w-full h-[380px] object-cover hover:scale-105 transition-transform duration-700"
                />
              </div>
            </div>

            <!-- Content Column -->
            <div class={`lg:col-span-7 space-y-6 ${isEven ? 'order-2 lg:order-1' : ''}`}>
              <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-brand-gold-dark font-semibold">
                <span>Service 0{index + 1}</span>
                <span>•</span>
                <span>Iconic Travel & Tours</span>
              </div>

              <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-emerald">
                {svc.title}
              </h2>

              <p class="text-base text-brand-charcoal-light leading-relaxed">
                {svc.description}
              </p>

              <!-- Offerings Checklist -->
              <div class="space-y-2.5 pt-2">
                <h4 class="font-serif text-sm font-bold text-brand-emerald uppercase tracking-wider">What We Provide:</h4>
                <ul class="space-y-2 text-xs text-brand-charcoal-muted">
                  {svc.offerings.map((item) => (
                    <li class="flex items-start gap-2.5">
                      <svg class="w-4 h-4 text-brand-gold flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Action CTAs -->
              <div class="pt-4 flex flex-wrap items-center gap-4">
                <a
                  href={`/iconic-travel-tours/request-a-quote/?service=${svc.slug}`}
                  class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-emerald text-brand-gold hover:bg-brand-forest shadow-md transition-all"
                >
                  <span>Inquire About This Service</span>
                  <span>→</span>
                </a>

                <a
                  href={`https://wa.me/${company.primaryWhatsApp}?text=${encodeURIComponent(`Assalamu Alaikum. I am interested in inquiring about ${svc.title}.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-3 rounded-full text-xs font-semibold tracking-wider bg-white text-[#25D366] border border-[#25D366]/40 hover:bg-[#25D366]/10 transition-colors"
                >
                  <span>WhatsApp Inquiry</span>
                </a>
              </div>

            </div>

          </div>
        );
      })}

    </div>
  </section>

  <!-- Bottom Quote Action -->
  <section class="py-16 bg-brand-forest text-white text-center">
    <div class="max-w-4xl mx-auto px-4 space-y-6">
      <h3 class="font-serif text-3xl font-bold text-white">Need a Bundled Corporate or Family Proposal?</h3>
      <p class="text-sm text-brand-ivory/80 max-w-xl mx-auto leading-relaxed">
        Our consultants can build a unified package encompassing flights, visas, 5-star suites, private GMCs, and full dining.
      </p>
      <div class="pt-2">
        <a
          href="/iconic-travel-tours/request-a-quote/"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full text-xs font-bold uppercase tracking-widest bg-brand-gold text-brand-emerald hover:brightness-110 shadow-gold-glow transition-all"
        >
          <span>Launch Multi-Step Quote Builder</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

</Layout>
